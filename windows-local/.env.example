# The app creates .env from this file on first run, and the panel's "keys" page edits it for you.
# NEVER commit .env (it is git-ignored).

# --- LLM (vision + reasoning) ---
# gemini (free tier, needs a key from https://aistudio.google.com/apikey) or ollama (fully local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model ids change often. Check https://ai.google.dev/gemini-api/docs/models and AI Studio for what your free key allows.
GEMINI_MODEL=gemini-flash-latest
# Comma separated models to try if the main one is rate limited (429) or overloaded (503)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Ollama (only if LLM_PROVIDER=ollama). Install from https://ollama.com then: ollama pull qwen3-vl:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
# Qwen style models may emit boxes as [xmin,ymin,xmax,ymax]. Set to xyxy if circles land in the wrong place.
OLLAMA_BOX_ORDER=yxyx

# --- Speech to text ---
# gemini (zero install, uses the same key), groq (free, faster, needs GROQ_API_KEY from https://console.groq.com/keys),
# faster-whisper (fully local, see README) or none (typing only)
STT_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_STT_MODEL=
WHISPER_SIDECAR_URL=http://127.0.0.1:8765
WHISPER_MODEL=small.en
PYTHON_BIN=python

# --- Text to speech ---
# sapi (built in Windows voices, zero install) or piper (better voice, see README) or none
TTS_PROVIDER=sapi
SAPI_RATE=1
SAPI_VOICE=
PIPER_EXE=C:\piper\piper.exe
PIPER_MODEL=C:\piper\en_US-lessac-medium.onnx

# --- Behaviour ---
# Push to talk keys held together. Supported: ctrl, alt, shift
PUSH_TO_TALK_KEYS=ctrl+alt
# Hide our own marks from screenshots (Windows 10 2004+). Recommended.
EXCLUDE_OVERLAY_FROM_CAPTURE=true
